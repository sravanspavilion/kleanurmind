# PostgreSQL database. Use a separate disposable database for integration/E2E tests.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kleanurmind?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kleanurmind_test?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth verifies customer email. Configure redirect /api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Explicit LOCAL development only. Ignored when NODE_ENV=production.
ENABLE_DEMO_AUTH="false"
# Generate a separate local secret; required by the development sign-in form.
DEMO_AUTH_KEY=""

# Private directory outside public/. Persistent volume required for multi-instance hosting.
UPLOAD_DIR="./private-uploads"

# S3-compatible storage (AWS S3, MinIO, Cloudflare R2, etc.)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="kleanurmind-uploads"
S3_REGION="us-east-1"

# Email (SMTP) - used by Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Klean Ur Mind <noreply@kleanurmind.in>"

# Notification provider: "disabled" | "development" | "production"
# "development" simulates sends and logs to console
NOTIFICATION_PROVIDER="disabled"

# Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Google Sheets connector (Apps Script web app).
# GOOGLE_SCRIPT_URL is the /exec deployment URL. GOOGLE_SCRIPT_SECRET is the
# SHARED_SECRET shown in the script's Project Settings > Script Properties
# (printed by setupSheets). Keep both on the server only.
GOOGLE_SCRIPT_URL=""
GOOGLE_SCRIPT_SECRET=""
# Optional: the sender address used for connector-only actions (health, pricing,
# area lookups). Defaults to an administrator's email when unset.
GOOGLE_SCRIPT_ACTOR_EMAIL=""

# Payment provider: "disabled" | "razorpay" | "stripe"
PAYMENT_PROVIDER="disabled"

# Razorpay (for INR payments in India)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (backup/international)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""