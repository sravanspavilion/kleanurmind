# Local environment (gitignored — never commit).
# Add any other settings you use locally (DATABASE_URL, NEXTAUTH_*, SMTP_*, etc.).

# Google Sheets connector (Apps Script web app).
# GOOGLE_SCRIPT_SECRET = the SHARED_SECRET in the Apps Script:
#   Project Settings (gear icon) > Script Properties > SHARED_SECRET
GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxUZtDahIvPNrBN4MjG4BTQHIbiIFAen-quOzWakVBtV8zViIXKnaeZWVUfJuGskUvs/exec"
GOOGLE_SCRIPT_SECRET=""

# --- Local development defaults (safe to change; never commit real secrets) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kleanurmind?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-local-secret-change-me"
ENABLE_DEMO_AUTH="true"
DEMO_AUTH_KEY="dev-demo-key-change-me"
UPLOAD_DIR="./private-uploads"
NOTIFICATION_PROVIDER="development"

# Public demo mode (opt-in). Leave false for normal production/local non-demo.
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
